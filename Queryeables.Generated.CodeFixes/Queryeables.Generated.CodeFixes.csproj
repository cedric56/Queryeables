<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The code fixes of the generator's diagnostics (QRY001, QRY003, QRY005-QRY008): a separate assembly, since a code fix needs
    the Workspaces API, which a source generator must not reference. Packed next to the generator, in analyzers/.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>
</Project>
