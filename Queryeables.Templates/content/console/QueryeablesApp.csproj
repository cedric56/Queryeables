<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brings the Queryeables package (its source generator, its global usings), Dommel and Microsoft.Data.Sqlite. -->
    <PackageReference Include="Queryeables.Sqlite" Version="QUERYEABLES_VERSION" />
  </ItemGroup>

</Project>
