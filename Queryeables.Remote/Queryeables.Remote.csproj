<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Shipped inside the "Queryeables" package (Queryeables.Core/Queryeables.nuspec), not as a package of its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Remote access, independent of any transport: the client store of the replicas (RemoteEntityStore), the server handlers
    that publish them, the routing and the wire contracts. A transport (MagicOnion, HTTP...) only implements IEntityTransport
    on the client, calls EntityRequestDispatcher on the server, and provides an IEntitySerializer. No package references.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Abstraction\Queryeables.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Queryeables.Tests" />
  </ItemGroup>

</Project>
