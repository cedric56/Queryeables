<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Queryeables.Offline</PackageId>
    <Description>The offline mode of Queryeables, and the generic remote writes it needs, on both sides: a client works on a local copy without the server and synchronizes (an outbox, conflicts to decide, writes applied once); a server lets its clients write and query through the exposed types (AllowWrites). Plugged into the core through its extension points. Experimental.</Description>
    <PackageTags>$(PackageTags);offline;sync;outbox</PackageTags>
    <!-- [JSImport] of BrowserOfflineStorage (offline mode in WebAssembly) needs it; no unsafe code is written. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Plugged into the core (the "Queryeables" package) through its extension points only: QueryeablesBuilder.DecorateStores,
    EntityServerBuilder.Handlers, IUserScopedData, the meter of QueryeablesDiagnostics. The core never names this package.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Core\Queryeables.Core.csproj" />
  </ItemGroup>

  <!-- The tests also check the filter translation, which is internal to this project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Queryeables.Tests" />
  </ItemGroup>

</Project>
