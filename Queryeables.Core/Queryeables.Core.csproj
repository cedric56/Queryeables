<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Queryeables</RootNamespace>
    <!--
      This project is the "Queryeables" package: it carries Abstraction, Remote, Core and the source generator
      (see Queryeables.nuspec). The projects below are built before the pack, so that their assemblies exist.
    -->
    <PackageId>Queryeables</PackageId>
    <NuspecFile>Queryeables.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version);configuration=$(Configuration)</NuspecProperties>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Abstraction\Queryeables.Abstraction.csproj" />
    <ProjectReference Include="..\Queryeables.Remote\Queryeables.Remote.csproj" />
    <!-- Only so that the generator is built before the pack: nothing of it is referenced. The nuspec puts it in analyzers/. -->
    <ProjectReference Include="..\Queryeables.Generated\Queryeables.Generated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
