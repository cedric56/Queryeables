{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "Queryeables.Abstraction/*.csproj",
            "Queryeables.Remote/*.csproj",
            "Queryeables.Core/*.csproj",
            "Queryeables.Dommel/*.csproj",
            "Queryeables.Sqlite/*.csproj",
            "Queryeables.PostgreSql/*.csproj",
            "Queryeables.EntityFramework/*.csproj",
            "Queryeables.Onion/*.csproj",
            "Queryeables.Onion.Client/*.csproj",
            "Queryeables.Server/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "**/bin/**",
          "**/obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/queryeables"
    ],
    "globalMetadata": {
      "_appTitle": "Queryeables",
      "_appFooter": "Queryeables · MIT License · Copyright (c) 2026 Cédric Boutin",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/cedric56/Queryeables",
        "branch": "master"
      },
      "_appLogoPath": "images/logo-icon.svg",
      "_appFaviconPath": "images/logo-icon.svg",
      "_appName": "Queryeables"
    }
  }
}
