<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- In an application: <PackageReference Include="Queryeables.Sqlite" />, which brings the Queryeables package and its generator. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Queryeables.Sqlite\Queryeables.Sqlite.csproj" />
    <ProjectReference Include="..\..\Queryeables.Generated\Queryeables.Generated.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- What the package does by itself: the global usings of Queryeables. -->
  <Import Project="..\..\Queryeables.Core\build\Queryeables.targets" />

</Project>
