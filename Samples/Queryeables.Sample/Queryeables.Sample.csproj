<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- In an application: <PackageReference Include="Queryeables.Sqlite" />, which brings the Queryeables package and its generator. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Queryeables.Sqlite\Queryeables.Sqlite.csproj" />
    <ProjectReference Include="..\..\Queryeables.Generated\Queryeables.Generated.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
