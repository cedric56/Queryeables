<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Core\Queryeables.Core.csproj" />
    <ProjectReference Include="..\Queryeables.Sqlite\Queryeables.Sqlite.csproj" />
    <ProjectReference Include="..\Queryeables.PostgreSql\Queryeables.PostgreSql.csproj" />
    <ProjectReference Include="..\Queryeables.MongoDB\Queryeables.MongoDB.csproj" />
    <ProjectReference Include="..\Queryeables.Dommel\Queryeables.Dommel.csproj" />
    <ProjectReference Include="..\Queryeables.EntityFramework\Queryeables.EntityFramework.csproj" />
    <ProjectReference Include="..\Queryeables.MagicOnion\Queryeables.MagicOnion.csproj" />
    <ProjectReference Include="..\Queryeables.Replication\Queryeables.Replication.csproj" Condition="$(HasRouteablesRemote)" />
  </ItemGroup>

  <!-- The replication tests need Routeables.SignalR next to this repository (Directory.Build.props). -->
  <ItemGroup Condition="!$(HasRouteablesRemote)">
    <Compile Remove="Unit/ReplicationStoreTests.cs;Contract/ReplicationStoreContracts.cs" />
  </ItemGroup>

  <!-- The source generator, run on the test entities like in an application, and called directly by the generator tests. -->
  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Generated\Queryeables.Generated.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
