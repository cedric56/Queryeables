<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Server side: Hub and IHubContext are part of ASP.NET Core, shipped with .NET.
    The Microsoft.AspNetCore.SignalR.Core NuGet package is an old, obsolete 1.x version: do not use it.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Abstraction\Queryeables.Abstraction.csproj" />
    <ProjectReference Include="..\Queryeables.SignalR\Queryeables.SignalR.csproj" />
  </ItemGroup>

</Project>
