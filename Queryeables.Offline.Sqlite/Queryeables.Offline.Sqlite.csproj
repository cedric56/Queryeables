<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Queryeables.Offline.Sqlite</PackageId>
    <Description>Offline storage for Queryeables.Offline in a SQLite file: the offline copy and its queue, on desktop and mobile.</Description>
    <PackageTags>$(PackageTags);offline;sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Offline\Queryeables.Offline.csproj" />
  </ItemGroup>

</Project>
