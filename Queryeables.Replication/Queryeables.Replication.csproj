<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Queryeables.Replication</PackageId>
    <Description>A durable server for the Routeables Remote Protocol: its log, merged documents and replicas in any Queryeables store (EF Core, MongoDB, Dommel, PostgreSQL), and the merged documents written to your own entities.</Description>
  </PropertyGroup>

  <!--
    The Routeables Remote Protocol (src/Routeables.Remote, no package reference). For now its sources, in the repository
    Routeables.SignalR next to this one (RouteablesRemoteRoot, Directory.Build.props). Once Routeables.Remote
    is published, the package replaces them (see the commented reference).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Abstraction\Queryeables.Abstraction.csproj" />
    <ProjectReference Include="$(RouteablesRemoteRoot)src\Routeables.Remote\Routeables.Remote.csproj" Condition="$(HasRouteablesRemote)" />
  </ItemGroup>

  <!-- Routeables.SignalR not cloned: an empty assembly, never packed, so that the rest of the solution builds. -->
  <PropertyGroup Condition="!$(HasRouteablesRemote)">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="!$(HasRouteablesRemote)">
    <Compile Remove="**/*.cs" />
  </ItemGroup>
  <Target Name="RouteablesRemoteMissing" BeforeTargets="Build" Condition="!$(HasRouteablesRemote)">
    <Error Condition="'$(ContinuousIntegrationBuild)' == 'true'" Text="Routeables.SignalR is not at $(RouteablesRemoteRoot): Queryeables.Replication cannot be built." />
    <Warning Text="Queryeables.Replication left out: clone Routeables.SignalR at $(RouteablesRemoteRoot) (or set RouteablesRemoteRoot) to build it." />
  </Target>
  <!--<ItemGroup>
    <PackageReference Include="Routeables.Remote" VersionOverride="$(RouteablesRemoteVersion)" />
  </ItemGroup>-->

  <ItemGroup>
    <InternalsVisibleTo Include="Queryeables.Tests" />
  </ItemGroup>

</Project>
