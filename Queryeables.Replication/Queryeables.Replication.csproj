<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Queryeables.Replication</PackageId>
    <Description>A durable server for the Routeables Remote Protocol: its log, merged documents and replicas in any Queryeables store (EF Core, MongoDB, Dommel, PostgreSQL), and the merged documents written to your own entities.</Description>
  </PropertyGroup>

  <!--
    The Routeables Remote Protocol (src/Routeables.Remote, no package reference). For now its sources, in the repository
    Routeables.SignalR next to this one (RouteablesRemoteRoot, Directory.Build.props). Once Routeables.Remote
    is published, the package replaces them (see the commented reference).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Abstraction\Queryeables.Abstraction.csproj" />
    <ProjectReference Include="$(RouteablesRemoteRoot)src\Routeables.Remote\Routeables.Remote.csproj" />
  </ItemGroup>
  <!--<ItemGroup>
    <PackageReference Include="Routeables.Remote" VersionOverride="$(RouteablesRemoteVersion)" />
  </ItemGroup>-->

  <ItemGroup>
    <InternalsVisibleTo Include="Queryeables.Tests" />
  </ItemGroup>

</Project>
