<Project>

  <!-- Package metadata shared by every project. Versions come from the build: -p:Version=0.1.0 -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0-dev</Version>
    <Authors>Cédric Boutin</Authors>
    <Copyright>Copyright (c) 2026 Cédric Boutin</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cedric56/Queryeables</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cedric56/Queryeables</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>data-access;dommel;efcore;magiconion;signalr;sqlite;cache;sync</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Packages that can be traced to their sources: the commit and the repository are recorded (SourceLink, built into
         the SDK), and a CI build gives the same paths whatever the machine. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing or partial XML comments on public members are not reported. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!--
    Where the Routeables.SignalR repository is checked out (Queryeables.Replication references its src/Routeables.Remote): in
    .external/Routeables.SignalR (the CI), else next to this repository. As a full path, so that one project has one path.
  -->
  <PropertyGroup>
    <RouteablesSignalRRoot Condition="'$(RouteablesSignalRRoot)' == '' And Exists('$(MSBuildThisFileDirectory).external/Routeables.SignalR')">$(MSBuildThisFileDirectory).external/Routeables.SignalR/</RouteablesSignalRRoot>
    <RouteablesSignalRRoot Condition="'$(RouteablesSignalRRoot)' == ''">$(MSBuildThisFileDirectory)../Routeables.SignalR/</RouteablesSignalRRoot>
    <RouteablesSignalRRoot>$([MSBuild]::NormalizeDirectory('$(RouteablesSignalRRoot)'))</RouteablesSignalRRoot>
  </PropertyGroup>

  <!-- Every library builds without warnings (nullability, trimming, AOT): one place, so that no project escapes it. Tests,
       benchmarks and samples are left out. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Queryeables.Tests' And '$(MSBuildProjectName)' != 'Queryeables.Benchmarks' And !$(MSBuildProjectDirectory.Contains('Samples'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Each package shows the README of its project; the README of the repository when the project has none. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false' And !Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
