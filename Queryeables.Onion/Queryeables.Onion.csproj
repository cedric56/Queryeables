<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Abstractions" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queryeables.Abstraction\Queryeables.Abstraction.csproj" />
  </ItemGroup>

  <!-- The tests also check the filter translation, which is internal to this project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Queryeables.Tests" />
  </ItemGroup>

</Project>
